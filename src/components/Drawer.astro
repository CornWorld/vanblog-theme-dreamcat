---
// 左侧抽屉(原版 header.php 抽屉结构 1:1):
// mdui-list.DreamCat-List-01 + mdui-card.DreamCat-List-02 + DreamCat-menu-bg
// (185px 品牌横图)+ Logo_centered 头像(75px, 上叠)+ covered 站名条 +
// mdui-collapse 手风琴(归档/分类)+ mdui-divider + 文章数 chip。
import Icon from "./Icon.astro";
import { withBase } from "../lib/base";
import type { Site, Category } from "@vanblog/sdk";

interface Props {
  site: Partial<Site>;
  drawerBgUrl: string;
  categories: Category[];
  postCount: number;
  currentPath: string;
  packNavItems: { label: string; href: string }[];
  showAdminButton: boolean;
  showRSS: boolean;
}

const {
  site,
  drawerBgUrl,
  categories,
  postCount,
  currentPath,
  packNavItems,
  showAdminButton,
  showRSS,
} = Astro.props;

const siteName = site?.siteName || "DreamCat";
const avatar = site?.authorLogo || site?.siteLogo || `${__VANBLOG_THEME_PREFIX__}/img/default-avatar.png`;
const brandStyle = drawerBgUrl
  ? `background: url('${drawerBgUrl}')`
  : "background: url('/img/brand.jpg')";

const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);

// 平台自定义导航(旗舰同语义:非空则整体替换默认导航)
const customNav = (site?.nav ?? []).map((n) => ({
  label: n.name,
  href: withBase(n.value),
}));
---

<div class="mc-drawer mdui-drawer mdui-drawer-left" id="dc-drawer">
  <div class="mdui-list DreamCat-List-01">
    <!-- 品牌卡(v2 原结构:menu-bg 横图 + covered 站名条 + 头像叠出) -->
    <div class="mdui-card DreamCat-List-02" style="overflow: inherit;">
      <div class="DreamCat-menu-bg" style={brandStyle}>
        <div class="Logo_centered">
          <img class="DreamCat-List-headimg" src={avatar} alt={siteName} loading="lazy" />
        </div>
        <div class="mdui-card-media-covered">
          <div class="mdui-card-primary">
            <div class="DreamCat-menu-author mdui-center" style="font-weight: 400; text-align: center;">
              {siteName}
            </div>
          </div>
        </div>
      </div>
    </div>

    {
      customNav.length > 0 ? (
        customNav.map((entry) => (
          <a href={entry.href}>
            <li class:list={["mdui-list-item mdui-ripple", { "mdui-list-item-active": isActive(entry.href) }]}>
              <i class="mdui-list-item-icon mdui-icon material-icons">near_me</i>
              <div class="mdui-list-item-content">{entry.label}</div>
            </li>
          </a>
        ))
      ) : (
        <>
          <a href={withBase("/")}>
            <li class:list={["mdui-list-item mdui-ripple", { "mdui-list-item-active": isActive("/") }]}>
              <i class="mdui-list-item-icon mdui-icon material-icons">near_me</i>
              <div class="mdui-list-item-content">首页</div>
            </li>
          </a>

          <div class="mdui-collapse mdui-collapse-item">
            <div class="mdui-collapse-item-header mdui-list-item mdui-ripple">
              <i class="mdui-list-item-icon mdui-icon material-icons">inbox</i>
              <div class="mdui-list-item-content">归档</div>
              <i class="mdui-collapse-item-arrow mdui-list-item-icon mdui-icon material-icons">keyboard_arrow_down</i>
            </div>
            <div class="mdui-collapse-item-body">
              <ul class="mdui-list mdui-list-dense">
                <li class="mdui-list-item mdui-ripple">
                  <a class="mdui-list-item-content" href={withBase("/archive")}>全部文章</a>
                </li>
                <li class="mdui-list-item mdui-ripple">
                  <a class="mdui-list-item-content" href={withBase("/timeline")}>时间轴</a>
                </li>
              </ul>
            </div>
          </div>

          <div class="mdui-collapse mdui-collapse-item">
            <div class="mdui-collapse-item-header mdui-list-item mdui-ripple">
              <i class="mdui-list-item-icon mdui-icon material-icons">view_week</i>
              <div class="mdui-list-item-content">分类</div>
              <i class="mdui-collapse-item-arrow mdui-list-item-icon mdui-icon material-icons">keyboard_arrow_down</i>
            </div>
            <div class="mdui-collapse-item-body">
              <ul class="mdui-list mdui-list-dense">
                {categories.length === 0 ? (
                  <li class="mdui-list-item mdui-ripple">
                    <a class="mdui-list-item-content" href={withBase("/categories")}>暂无分类</a>
                  </li>
                ) : (
                  categories.map((c) => (
                    <li class="mdui-list-item mdui-ripple">
                      <a class="mdui-list-item-content" href={withBase(`/categories/${c.id}`)} title={c.name}>
                        {c.name}
                      </a>
                    </li>
                  ))
                )}
              </ul>
            </div>
          </div>

          <a href={withBase("/tags")}>
            <li class:list={["mdui-list-item mdui-ripple", { "mdui-list-item-active": isActive("/tags") }]}>
              <i class="mdui-list-item-icon mdui-icon material-icons">label</i>
              <div class="mdui-list-item-content">标签</div>
            </li>
          </a>

          {packNavItems.map((p) => (
            <a href={p.href}>
              <li class:list={["mdui-list-item mdui-ripple", { "mdui-list-item-active": isActive(p.href) }]}>
                <i class="mdui-list-item-icon mdui-icon material-icons">description</i>
                <div class="mdui-list-item-content">{p.label}</div>
              </li>
            </a>
          ))}

          {(site?.links?.length ?? 0) > 0 && (
            <a href={withBase("/link")}>
              <li class:list={["mdui-list-item mdui-ripple", { "mdui-list-item-active": isActive("/link") }]}>
                <i class="mdui-list-item-icon mdui-icon material-icons">link</i>
                <div class="mdui-list-item-content">友链</div>
              </li>
            </a>
          )}

          {site?.aboutContent && site.aboutContent.trim() && (
            <a href={withBase("/about")}>
              <li class:list={["mdui-list-item mdui-ripple", { "mdui-list-item-active": isActive("/about") }]}>
                <i class="mdui-list-item-icon mdui-icon material-icons">person</i>
                <div class="mdui-list-item-content">关于</div>
              </li>
            </a>
          )}
        </>
      )
    }

    {
      showRSS && (
        <a href={withBase("/api/feed.xml")} target="_blank" rel="noopener">
          <li class="mdui-list-item mdui-ripple">
            <i class="mdui-list-item-icon mdui-icon material-icons">rss_feed</i>
            <div class="mdui-list-item-content">RSS</div>
          </li>
        </a>
      )
    }

    {
      showAdminButton && (
        <a href="/admin/" target="_blank" rel="noopener">
          <li class="mdui-list-item mdui-ripple">
            <i class="mdui-list-item-icon mdui-icon material-icons">account_box</i>
            <div class="mdui-list-item-content">后台</div>
          </li>
        </a>
      )
    }

    <div class="mdui-divider" />

    <a>
      <li class="mdui-list-item">
        <i class="mdui-list-item-icon mdui-icon material-icons">description</i>
        <span class="mdui-list-item-content">文章</span>
        <div class="mdui-chip">
          <span class="mdui-chip-title">{postCount} 篇</span>
        </div>
      </li>
    </a>
  </div>
</div>

<script>
  // 当前所在分类时,展开抽屉分类手风琴(mdui collapse 初始态)
  if (window.location.pathname.startsWith("/categories")) {
    document.querySelectorAll("#dc-drawer .mdui-collapse-item").forEach((el) => {
      const label = el.querySelector(".mdui-list-item-content");
      if (label && label.textContent?.trim() === "分类") el.classList.add("mdui-collapse-item-open");
    });
  }
</script>
