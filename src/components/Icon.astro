---
// 图标(v2 1:1):material-icons ligature 字体(由 mdui-lite 提供
// .mdui-icon/.material-icons 类与主题持有的字体文件),与原版
// <i class="mdui-icon material-icons">search</i> 完全同源,对齐/字号
// 由 mdui 样式保证。name → ligature 名映射见 LIGATURES。
interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;

const LIGATURES: Record<string, string> = {
  menu: "menu",
  search: "search",
  home: "near_me",
  archive: "inbox",
  folder: "view_week",
  tag: "label",
  schedule: "access_time",
  link: "link",
  person: "person",
  rss: "rss_feed",
  visibility: "visibility",
  list: "format_list_bulleted",
  close: "close",
  arrowDown: "keyboard_arrow_down",
  arrowLeft: "arrow_back",
  arrowRight: "arrow_forward",
  arrowUp: "arrow_upward",
  chat: "chat_bubble_outline",
  pin: "turnedin",
  image: "image",
  description: "description",
  email: "email",
  send: "send",
  copyright: "copyright",
  palette: "palette",
  brush: "brush",
  whatshot: "whatshot",
  edit: "mode_edit",
  share: "share",
};

const ligature = LIGATURES[name] ?? name;
---

<i class:list={["mdui-icon material-icons", className]} style={`font-size:${size}px`} aria-hidden="true">
  {ligature}
</i>
