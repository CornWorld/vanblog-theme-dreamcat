---
// 页码(原版 moe-page-div 1:1):prev/next 为 mini FAB(主色底),页码居中。
import Icon from "./Icon.astro";
import { buildPageHref } from "@vanblog/sdk";

interface Props {
  base: string;
  params: URLSearchParams;
  page: number;
  totalPages: number;
}

const { base, params, page, totalPages } = Astro.props;
---

{
  totalPages > 1 && (
    <div class="moe-page-div">
      {page > 1 ? (
        <a class="mdui-fab mdui-fab-mini mdui-ripple dreamcat-fab-primary" href={buildPageHref(base, params, page - 1)} rel="prev" aria-label="上一页">
          <Icon name="arrowLeft" size={18} />
        </a>
      ) : (
        <span class="mdui-fab mdui-fab-mini dreamcat-fab-primary is-disabled" aria-hidden="true">
          <Icon name="arrowLeft" size={18} />
        </span>
      )}
      <span class="moe-number">
        {page} / {totalPages}
      </span>
      {page < totalPages ? (
        <a class="mdui-fab mdui-fab-mini mdui-ripple dreamcat-fab-primary moe-next" href={buildPageHref(base, params, page + 1)} rel="next" aria-label="下一页">
          <Icon name="arrowRight" size={18} />
        </a>
      ) : (
        <span class="mdui-fab mdui-fab-mini dreamcat-fab-primary moe-next is-disabled" aria-hidden="true">
          <Icon name="arrowRight" size={18} />
        </span>
      )}
    </div>
  )
}
