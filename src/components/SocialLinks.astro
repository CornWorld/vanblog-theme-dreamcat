---
// 社交图标行(v2 1:1):图标来自原版 alifont SVG symbol 库
// (public/js/alifont_2359325_loysvemas8m.js,与 Typecho 版同一份资产),
// <svg class="dc_icon"><use href="#dc_icon*"/></svg> 引用,尺寸/对齐由
// .dc_icon 统一控制(原版同款样式)。
// 值语义:图片 URL → 点击弹二维码(原版 DC_A_* 弹窗);http 链接 → 直链;
// 邮箱 → mailto;其余 → 非链接徽标。alifont 缺失的类型回落 material ligature。
import Icon from "./Icon.astro";
import type { SocialItem } from "@vanblog/sdk";

interface Props {
  socials?: SocialItem[] | null;
  size?: number;
}

const { socials, size = 24 } = Astro.props;
const items = (socials ?? []).filter((s) => s?.type && s?.value);
const isImageUrl = (v: string) => /\.(png|jpe?g|webp|gif|bmp)(\?|#|$)/i.test(v);

// type → alifont symbol id(缺省回落 material ligature)
const SYMBOLS: Record<string, string> = {
  qq: "#dc_iconQQ",
  wechat: "#dc_iconweixin",
  weibo: "#dc_icon552cd5bdeaada",
  alipay: "#dc_iconzhifubao",
  github: "#dc_icongithub",
  linkedin: "#dc_iconlinkedin",
};
---

{
  items.length > 0 && (
    <div class="dc-social" id="dc-social-row">
      {items.map((s) => {
        const qr = isImageUrl(s.value);
        const isHttp = /^https?:\/\//i.test(s.value);
        const isMail = s.type === "email" || /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(s.value);
        const symbol = SYMBOLS[s.type];
        const svg = symbol ? (
          <svg class="dc_icon" width={size} height={size} aria-hidden="true">
            <use href={symbol} />
          </svg>
        ) : (
          <Icon name={s.type === "email" ? "email" : "link"} size={size - 4} />
        );
        if (qr) {
          return (
            <button class="mdui-ripple" title={s.type} aria-label={s.type} data-dc-qr={s.value} data-dc-qr-type={s.type}>
              {svg}
            </button>
          );
        }
        if (isHttp) {
          return (
            <a class="mdui-ripple" href={s.value} title={s.value} aria-label={s.type} target="_blank" rel="noopener noreferrer">
              {svg}
            </a>
          );
        }
        if (isMail) {
          return (
            <a class="mdui-ripple" href={`mailto:${s.value}`} title={s.value} aria-label={s.type}>
              {svg}
            </a>
          );
        }
        return (
          <span class="mdui-ripple" title={s.value} aria-label={s.type}>
            {svg}
          </span>
        );
      })}
    </div>
  )
}

<script>
  // 二维码弹层(原版 DC_A_* mdui-dialog 的移植;委托监听)
  document.addEventListener("click", (e) => {
    const t = e.target as HTMLElement;
    const trigger = t.closest?.("[data-dc-qr]") as HTMLElement | null;
    if (!trigger || !window.mdui) return;
    const src = trigger.dataset.dcQr || "";
    const type = trigger.dataset.dcQrType || "";
    const names: Record<string, string> = {
      qq: "加我的QQ",
      wechat: "加我的微信",
      weibo: "加我的微博",
      alipay: "加我的支付宝",
    };
    window.mdui.dialog({
      title: names[type] || type,
      content: `<div class="dc-qr-dialog"><img src="${src}" alt="${type} 二维码" loading="lazy" /></div>`,
      buttons: [{ text: "确认" }],
      history: false,
    });
  });
</script>
