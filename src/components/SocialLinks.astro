---
// 社交图标行。数据源:平台 site.socials([{type, value}])。
// 值语义对齐原版 DC_A_* 配置:
// - 图片 URL(png/jpg/webp/gif)→ 点击弹 mdui Dialog 展示二维码(原版 QQ/微信/支付宝弹层)
// - http(s) 链接 → 直链新开
// - 邮箱 → mailto
// - 其余(纯号码等)→ 非链接徽标
import { resolveSocialIcon } from "../lib/socials";
import type { SocialItem } from "@vanblog/sdk";

interface Props {
  socials?: SocialItem[] | null;
  size?: number;
}

const { socials, size = 20 } = Astro.props;
const items = (socials ?? []).filter((s) => s?.type && s?.value);
const isImageUrl = (v: string) => /\.(png|jpe?g|webp|gif|bmp)(\?|#|$)/i.test(v);
---

{
  items.length > 0 && (
    <div class="dc-social" id="dc-social-row">
      {items.map((s) => {
        const icon = resolveSocialIcon(s.type);
        const qr = isImageUrl(s.value);
        const isHttp = /^https?:\/\//i.test(s.value);
        const isMail = s.type === "email" || /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(s.value);
        const svg = icon ? (
          <svg width={size} height={size} viewBox={icon.viewBox} fill="currentColor" aria-hidden="true">
            <Fragment set:html={icon.body} />
          </svg>
        ) : (
          <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z" />
          </svg>
        );
        // 二维码 → 弹层按钮(原版 DC_A_* 二维码弹窗);链接 → 直链;邮箱 → mailto;其余 → 徽标
        if (qr) {
          return (
            <button class="mdui-ripple" title={s.type} aria-label={s.type} data-dc-qr={s.value} data-dc-qr-type={s.type}>
              {svg}
            </button>
          );
        }
        if (isHttp) {
          return (
            <a class="mdui-ripple" href={s.value} title={s.type} aria-label={s.type} target="_blank" rel="noopener noreferrer">
              {svg}
            </a>
          );
        }
        if (isMail) {
          return (
            <a class="mdui-ripple" href={`mailto:${s.value}`} title={s.type} aria-label={s.type}>
              {svg}
            </a>
          );
        }
        return (
          <span class="mdui-ripple" title={s.value} aria-label={s.type}>
            {svg}
          </span>
        );
      })}
    </div>
  )
}

<script>
  // 二维码弹层(原版 DC_A_* mdui-dialog 的移植;委托监听,动态内容亦生效)
  document.addEventListener("click", (e) => {
    const t = e.target as HTMLElement;
    const trigger = t.closest?.("[data-dc-qr]") as HTMLElement | null;
    if (!trigger || !window.mdui) return;
    const src = trigger.dataset.dcQr || "";
    const type = trigger.dataset.dcQrType || "";
    const names: Record<string, string> = {
      qq: "加我的QQ",
      wechat: "加我的微信",
      weibo: "加我的微博",
      alipay: "加我的支付宝",
    };
    window.mdui.dialog({
      title: names[type] || type,
      content: `<div class="dc-qr-dialog"><img src="${src}" alt="${type} 二维码" loading="lazy" /></div>`,
      buttons: [{ text: "确认" }],
      history: false,
    });
  });
</script>
