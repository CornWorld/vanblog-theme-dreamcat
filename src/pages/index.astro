---
// 首页(v2 LTS index.php 1:1):
// content-header 标题带(右浮搜索 FAB 弹搜索框)→ 顶部双卡(横幅大图卡 +
// 作者卡)→ 文章列表(ImgMode 封面卡 / 文字模式卡;meta.timershaft_opt
// A/B/C/D 的文章渲染为说说/日志/公告/状态时间轴卡)→ 页码(prev/next FAB)。
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import Pagination from "../components/Pagination.astro";
import SocialLinks from "../components/SocialLinks.astro";
import Icon from "../components/Icon.astro";
import { getPage, stripMarkdown, postMetaString } from "@vanblog/sdk";
import { withBase, articlePath } from "../lib/base";
import { fmtDate } from "../lib/dates";
import type { PostExpand } from "@vanblog/sdk";

const pb = Astro.locals.pb;
const site = await Astro.locals.getSite();

const params = Astro.url.searchParams;
const page = getPage(params);
// 置顶优先(对齐原版 Typecho 置顶语义)
const result = await pb.vanblog.posts.listPublished(page, 10, { sort: "-top,-created", expand: "category,tags" }).catch(() => null);
const posts = (result?.items ?? []) as PostExpand[];
const totalPages = result?.totalPages ?? 1;

const themeSettings = await Astro.locals.getThemeSettings();
const sStr = (key: string) => (typeof themeSettings[key] === "string" ? (themeSettings[key] as string).trim() : "");
const bannerUrl = sStr("heroImageUrl");
const bannerCaption = sStr("bannerCaption");
const authorCoverUrl = sStr("authorCoverUrl");

const siteName = site?.siteName || "DreamCat";
const siteDesc = site?.siteDesc || "";
const avatar = site?.authorLogo || site?.siteLogo || `${__VANBLOG_THEME_PREFIX__}/img/default-avatar.png`;

// timershaft_opt:A 说说 / B 日志 / C 公告 / D 状态(原版首页时间轴卡)
const TIMERSHAFT_NAMES: Record<string, string> = { A: "说 说", B: "日 志", C: "公 告", D: "状 态" };
const listPosts: PostExpand[] = [];
const timershaftPosts: PostExpand[] = [];
for (const p of posts) {
  const opt = postMetaString(p?.meta, "timershaft_opt");
  if (TIMERSHAFT_NAMES[opt ?? ""]) timershaftPosts.push(p);
  else listPosts.push(p);
}
---

<BaseLayout title="" path="/" site={site ?? {}}>
  <!-- 标题带(原版 DreamCat-content-header,indigo) -->
  <div class="DreamCat-content-header">
    <div class="dc-container">
      <h1 class="dreamcat-title">{siteName}</h1>
      <h5 class="dreamcat-subtitle">{siteDesc}</h5>
    </div>
    <a
      class="dreamcat-search-fab mdui-fab mdui-ripple mdui-ripple-white"
      href={withBase("/search")}
      title="搜索"
      aria-label="搜索"
    >
      <Icon name="search" size={24} />
    </a>
  </div>

  <div class="dc-container">
    <!-- 顶部双卡(原版 DreamCat-top-card 双卡) -->
    <div class="mdui-container"><div class="mdui-row">
      
      <!-- 横幅大图卡(v2 原结构: mdui-card-media + covered 标题条;headbj1/DC_Dec) -->
      <div class="mdui-col-xs-12 mdui-col-sm-8">
        <div class="mdui-card DreamCat-top-card shadow-A1" style="border-radius: 18px; overflow: hidden">
          <div class="mdui-card-media">
            {bannerUrl ? (
              <img class="DreamCat-main-pic" src={bannerUrl} alt="" />
            ) : (
              <div class="DreamCat-main-pic" style="background-color: var(--dc-primary)" />
            )}
            <div class="mdui-card-media-covered">
              <div class="mdui-card-primary">
                <div class="mdui-card-primary-title">{bannerCaption || siteDesc || siteName}</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 作者卡(v2 原结构: 封面 + 头像叠出 + chip 简介 + 社交 icons;headbj2/DC_Decc) -->
      <div class="mdui-hidden-xs mdui-col-sm-4">
        <div class="mdui-card DreamCat-top-card shadow-A1" style="border-radius: 18px; overflow: visible">
          <div class="mdui-card-media">
            {authorCoverUrl ? (
              <img src={authorCoverUrl} alt="" style="height: 100px; width: 100%; object-fit: cover; display: block" />
            ) : (
              <div style="height: 100px; background-color: var(--dc-primary)" />
            )}
          </div>
          <div class="Logo_centered">
            {avatar ? (
              <img class="DreamCat-List-headimg" src={avatar} alt={site?.author || siteName} style="margin-top: -50px; position: relative" />
            ) : (
              <span class="DreamCat-List-headimg dc-avatar-ph" style="margin-top: -50px; position: relative" />
            )}
          </div>
          <div class="number" style="color: #999; font-size: 15px; display: flex; justify-content: center; margin: 1%">
            <div class="mdui-chip">
              <span class="mdui-chip-title">{siteDesc || "博主很懒,啥都没写"}</span>
            </div>
          </div>
          <div style="text-align: center">
            <SocialLinks socials={site?.socials} />
          </div>
        </div>
      </div>
    </div>

    <!-- 文章列表 -->
    <div class="dc-post-list">
      {
        listPosts.length === 0 && timershaftPosts.length === 0 ? (
          <div class="dc-card dc-card--lg">
            <div class="dc-empty">博主很懒,啥都没写 (๑╹っ╹๑)</div>
          </div>
        ) : (
          <>
            {listPosts.map((post) => (
              <PostCard post={post} />
            ))}
            <div id="main" style="position: relative">
              <div id="line" />
              {timershaftPosts.map((post) => {
                const opt = postMetaString(post?.meta, "timershaft_opt") ?? "";
                return (
                  <div class="lis coos">
                    <div class="spot" />
                    <div class="g-lin mdui-hidden-sm-down" />
                    <div
                      class="mdui-card mdui-hoverable shadow-A1 dreamcat-timer-card"
                      style="background-color: #e8e8e8; border-radius: 6px"
                    >
                      <div class="mdui-card-primary">
                        <div class="mdui-card-primary-title" style="color: #282a36">{post.title}</div>
                        <div class="mdui-card-primary-subtitle" style="color: #282a36">
                          {stripMarkdown(post.content || "", 520)}
                        </div>
                      </div>
                      <a
                        class="dreamcat-timer-card__link"
                        href={withBase(`/posts/${articlePath(post.pathname, post.id)}`)}
                      >
                        查看全文 →
                      </a>
                    </div>
                  </div>
                );
              })}
            </div>
          </>
        )
      }
    </div>

    <Pagination base="/" params={params} page={page} totalPages={totalPages} />
  </div>
</BaseLayout>
